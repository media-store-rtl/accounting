{
  "name": "media-store-rtl/accounting",
  "type": "project",
  "description": "Independent industrial accounting and manufacturing cost management system.",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "laravel/tinker": "^3.0",
    "inertiajs/inertia-laravel": "^2.0",
    "phpoffice/phpspreadsheet": "5.10.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pail": "^1.2",
    "laravel/pint": "^1.24",
    "laravel/sail": "^1.41",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\\\": "tests/"
    }
  },
  "scripts": {
    "setup": ["composer install", "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"", "@php artisan key:generate", "@php artisan migrate --force"],
    "dev": "php artisan serve",
    "test": "@php artisan test"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
